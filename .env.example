# .env.example
#
# Copy this to a real .env file (never commit .env itself — it's already
# in .gitignore) if you want to override any default in config.py.
# None of these are required — the project runs fine with zero .env file,
# using the defaults defined in config.py.

# --- Storage ---
INCIDENT_DB_PATH=temp/incidents.db

# --- Logging ---
LOG_LEVEL=INFO

# --- Dataverse mode ---
# "mock" (default) or "live". Live mode is not implemented yet —
# see services/dataverse_client.py.
DATAVERSE_MODE=mock

# --- Azure credentials (NOT YET USED) ---
# These have no effect on current code. Placeholders only, for when
# Phase 2's live Dataverse/Azure AI Foundry integration begins.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# DATAVERSE_ORG_URL=